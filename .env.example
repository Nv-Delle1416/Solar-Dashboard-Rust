# Set to true to serve generated mock solar data with NO database connection.
# Great for previewing the chart. When true, DATABASE_URL is ignored.
MOCK_DATA=false

# MySQL/MariaDB connection string (this is the configurable "endpoint").
# Authentication is done entirely via this string -- there is no password prompt.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# - Percent-encode special characters in the password (e.g. @ -> %40, : -> %3A, / -> %2F).
# - Require TLS by appending ?ssl-mode=REQUIRED
# - mysql_native_password and caching_sha2_password (MySQL 8 default) are both supported.
# See the "Database connection & authentication" section of the README for details.
DATABASE_URL=mysql://user:password@localhost:3306/solar

# Table to query (must contain: id, Watts, wattsperhour, invertertime, created_at)
TABLE_NAME=readings

# Column used for the time axis / ordering (invertertime or created_at)
TIME_COLUMN=invertertime

# Where the web dashboard listens
BIND_ADDR=127.0.0.1:8080

# Max rows returned for the "Day" view (safety cap)
DEFAULT_LIMIT=1000

# Minutes between consecutive readings. Used to convert power (Watts) into
# energy (kWh): kWh = Watts / 1000 * (INTERVAL_MINUTES / 60).
INTERVAL_MINUTES=15

# Optional log level
RUST_LOG=info
